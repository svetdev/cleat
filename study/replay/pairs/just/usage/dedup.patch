+impl<D> Usage<'_, D> {
+  fn parameters(&self, f: &mut Formatter, color: Color, options: bool) -> fmt::Result {
+    for (i, parameter) in self
+      .recipe
+      .parameters
+      .iter()
+      .filter(|p| p.is_option() == options)
+      .enumerate()
+    {
+      if i > 0 {
+        writeln!(f)?;
       }
+
+      write!(f, "  ")?;
+
+      write!(
+        f,
+        "{}",
+        UsageParameter {
+          parameter,
+          long: true,
+        }
+        .color_display(color),
+      )?;
     }
 
     Ok(())
